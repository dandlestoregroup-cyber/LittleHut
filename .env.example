# Production: connect a private Vercel Blob store to the Vercel project.
# Vercel injects BLOB_READ_WRITE_TOKEN automatically for a connected store.
BLOB_READ_WRITE_TOKEN=

# Local development only. Production intentionally refuses to accept bookings
# without the shared Blob store.
STAYZA_ALLOW_FILE_STORE=1
STAYZA_DATA_DIR=.data
