# --- Operator console (required to enable /ops) ---
# Without OPS_ACCESS_KEY the operations console and its API refuse every
# request. It never defaults open.
OPS_ACCESS_KEY=
# Optional. Signs operator session cookies. Derived from OPS_ACCESS_KEY when
# unset; set it explicitly so rotating the access key does not invalidate
# every active session, and vice versa.
OPS_SESSION_SECRET=

# --- Booking ledger storage ---
# Production (Vercel Blob):
BLOB_READ_WRITE_TOKEN=
# Local development only — writes JSON records under .data/
# STAYZA_ALLOW_FILE_STORE=1
# STAYZA_DATA_DIR=.data

# --- Agent layer ---
# Set to 0 to disable the agent layer. Booking, availability and activation
# continue to work with it off.
# AGENTS_ENABLED=1
